<link rel="stylesheet" href="/css/article-writer-textEditor.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.js"></script>

<form id="article-writer-textEditor-createForm" action="" method="post" enctype="multipart/form-data">
  <div class="article-writer-textEditor-container">
      <div class="article-writer-textEditor-title">
        <textarea name="title" class="form-control" id="article-writer-textEditor-title" rows="1" placeholder="Title"></textarea>
      </div>
      <div class="article-writer-textEditor-title">
        <input 
          name="category" 
          class="form-control awesomplete" 
          id="article-writer-textEditor-categoryName" 
          placeholder="Category" 
          data-minchars="1" 
        />

        <ul id="categoryList" class="hidden">
          {{#each categoryList}}
            <li>{{this.name}}</li>
          {{/each}}
        </ul>
      </div>
      <div class="article-writer-textEditor-title">
        <textarea name="abstract" class="form-control" id="article-writer-textEditor-abstract" rows="2" placeholder="Abstract"></textarea>
      </div>

      <div class="article-writer-textEditor-actions">
        <div class="article-writer-textEditor-tagInput">
          <ul>
            <input type="text" spellcheck="false" placeholder="Nhập tối đa 3 nhãn cho bài viết">
          </ul>
        </div>

        <div class="article-writer-textEditor-thumbnail">
            <button type="button" id="article-writer-textEditor-openImagePopup" class="btn btn-light">Add Thumbnail</button>
        </div>

        <div id="article-writer-textEditor-imagePopup" class="article-writer-textEditor-imagePopup">
          <h3>Add Thumbnail</h3>
          <input type="file" id="article-writer-textEditor-imageFileInput" accept="image/*" name="image_url">
          <div class="previewContainer">
            <img id="article-writer-textEditor-thumbnailPreview" src="" alt="" class="article-writer-textEditor-thumbnailPreview">
          </div>
          <div class="popupActions">
            <button type="button" id="article-writer-textEditor-closePopupBtn" class="btn btn-danger">Close</button>
          </div>
        </div>

        <div id="article-writer-textEditor-popupOverlay" class="article-writer-textEditor-popupOverlay"></div>
        <button id="article-writer-textEditor-publish-button" type="button" class="btn btn-light article-writer-textEditor-publish-button">Published</button>
      </div>

      <div class="article-writer-textEditor-tagsDetail">
        <p>Can input <span>3</span> additional tag</p>
        <label>
          Premium:
          <input type="checkbox" name="premium" />
        </label>
      </div>

      <div class="article-text-editor">
          {{>article-writer-textEditor/text-editor placeholderText="Write the content of the article" textHeight= 500}}
      </div>
      <input type="hidden" name="content" id="article-writer-textEditor-articleContent">
      <input type="hidden" name="status" value="draft">
      <input type="hidden" name="author" value={{authorID}}>
  </div>
</form>

<script>
  const categories = {{{categoryListName}}};
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/public/js/article-writer-textEditor.js"></script>

<script>
var input = document.getElementById("article-writer-textEditor-categoryName");
new Awesomplete(input, {list: "#categoryList"});
</script>

<style>
  .awesomplete ul {
    width: 50%; /* Khớp với input nếu cần */
  }
  .awesomplete{
    width: 100%; /* Khớp với input nếu cần */
  }
</style>